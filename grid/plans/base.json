{
  "name": "底座合并",
  "mode": "continuous",
  "stages": [
    {
      "key": "merge",
      "name": "把考过试的答题、改 PPT、眼力 LoRA 合进底座（回归考试挑比例）",
      "kind": "map",
      "recipe": "base_merge",
      "recipeFile": "../recipes/base_merge.py",
      "when": {
        "outputsOf": "qa-math",
        "outputs": 300,
        "minHours": 168
      },
      "params": {
        "count": 1,
        "merge": [
          "qa-lora",
          "ppt-lora",
          "vision-lora"
        ],
        "modelsOf": [
          "base-stack",
          "qa-lora",
          "ppt-lora",
          "vision-lora"
        ],
        "scales": [
          1.0,
          0.7,
          0.5
        ],
        "tol": 0.02,
        "parallel": 2,
        "llm": {
          "name": "Qwen3VL-4B-Instruct-Q4_K_M.gguf",
          "mirrorModel": "llmMain",
          "ctx": 8192,
          "slots": 2,
          "urls": [
            "https://www.modelscope.cn/models/Qwen/Qwen3-VL-4B-Instruct-GGUF/resolve/master/Qwen3VL-4B-Instruct-Q4_K_M.gguf",
            "https://hf-mirror.com/Qwen/Qwen3-VL-4B-Instruct-GGUF/resolve/main/Qwen3VL-4B-Instruct-Q4_K_M.gguf",
            "https://huggingface.co/Qwen/Qwen3-VL-4B-Instruct-GGUF/resolve/main/Qwen3VL-4B-Instruct-Q4_K_M.gguf"
          ],
          "lazy": true
        }
      },
      "req": {
        "cpu": true,
        "llm": true,
        "ram": 16
      },
      "priority": 15
    }
  ],
  "publish": {
    "model": "base-stack",
    "from": "merge",
    "files": [
      "stack",
      "bundle",
      "train"
    ],
    "metrics": [
      {
        "k": "gsm8k",
        "better": "higher",
        "tol": 0.02,
        "min": "base_gsm8k",
        "minTol": 0.02
      },
      {
        "k": "read",
        "better": "higher",
        "tol": 0.02,
        "min": "base_read",
        "minTol": 0.02
      }
    ]
  }
}