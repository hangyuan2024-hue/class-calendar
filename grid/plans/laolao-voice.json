{
  "name": "捞捞声音",
  "mode": "continuous",
  "stages": [
    {
      "key": "voice",
      "name": "训练捞捞的专属声音（公开录音 AISHELL-3）",
      "kind": "map",
      "recipe": "voice_train",
      "recipeFile": "../recipes/voice_train.py",
      "when": {
        "tag": "voice",
        "manual": true
      },
      "params": {
        "count": 1,
        "member": "捞捞",
        "openVoice": "aishell3",
        "shift": 2,
        "minSeconds": 300,
        "sovitsEpochs": 8,
        "gptEpochs": 15,
        "batch": 4,
        "samples": [
          "你好，我是捞捞，今天要改哪一页？",
          "好的，第三页的标题已经改好了，你看看行不行。",
          "这道题我们一步一步来，先看已知条件。"
        ],
        "modelOf": "voice-base"
      },
      "req": {
        "vram": 5.5,
        "gsv": true
      },
      "priority": 40
    }
  ],
  "publish": {
    "model": "laolao-voice",
    "from": "voice",
    "files": [
      "gpt",
      "sovits",
      "ref",
      "reftext"
    ],
    "releaseEqual": true,
    "metrics": []
  }
}