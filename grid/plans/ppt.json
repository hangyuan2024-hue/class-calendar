{
  "name": "PPT 操作工厂",
  "mode": "continuous",
  "stages": [
    {
      "key": "gen",
      "name": "练改 PPT（空闲显卡：程序出题、真的去改、程序判对错，留下做对的）",
      "kind": "map",
      "recipe": "ppt_gen",
      "recipeFile": "../recipes/ppt_gen.py",
      "standing": true,
      "keep": 20,
      "params": {
        "per": 12,
        "tries": 4,
        "temperature": 0.7,
        "demoShare": 0.5,
        "parallel": 2,
        "tag": "ppt",
        "modelsOf": [
          "base-stack/stack,bundle",
          "ppt-lora/lora"
        ],
        "llm": {
          "name": "Qwen3VL-4B-Instruct-Q4_K_M.gguf",
          "mirrorModel": "llmMain",
          "ctx": 16384,
          "slots": 2,
          "urls": [
            "https://www.modelscope.cn/models/Qwen/Qwen3-VL-4B-Instruct-GGUF/resolve/master/Qwen3VL-4B-Instruct-Q4_K_M.gguf",
            "https://hf-mirror.com/Qwen/Qwen3-VL-4B-Instruct-GGUF/resolve/main/Qwen3VL-4B-Instruct-Q4_K_M.gguf",
            "https://huggingface.co/Qwen/Qwen3-VL-4B-Instruct-GGUF/resolve/main/Qwen3VL-4B-Instruct-Q4_K_M.gguf"
          ]
        }
      },
      "req": {
        "vram": 7.5,
        "llm": true
      },
      "priority": 8
    },
    {
      "key": "cpu",
      "name": "练改 PPT（CPU 慢慢做）",
      "kind": "map",
      "recipe": "ppt_gen",
      "recipeFile": "../recipes/ppt_gen.py",
      "standing": true,
      "keep": 10,
      "params": {
        "per": 4,
        "tries": 2,
        "temperature": 0.7,
        "demoShare": 0.5,
        "parallel": 1,
        "tag": "ppt",
        "modelsOf": [
          "base-stack/stack,bundle",
          "ppt-lora/lora"
        ],
        "llm": {
          "name": "Qwen3VL-4B-Instruct-Q4_K_M.gguf",
          "mirrorModel": "llmMain",
          "ctx": 16384,
          "slots": 1,
          "urls": [
            "https://www.modelscope.cn/models/Qwen/Qwen3-VL-4B-Instruct-GGUF/resolve/master/Qwen3VL-4B-Instruct-Q4_K_M.gguf",
            "https://hf-mirror.com/Qwen/Qwen3-VL-4B-Instruct-GGUF/resolve/main/Qwen3VL-4B-Instruct-Q4_K_M.gguf",
            "https://huggingface.co/Qwen/Qwen3-VL-4B-Instruct-GGUF/resolve/main/Qwen3VL-4B-Instruct-Q4_K_M.gguf"
          ]
        }
      },
      "req": {
        "cpu": true,
        "llm": true,
        "ram": 8
      },
      "priority": 2
    },
    {
      "key": "train",
      "name": "训练改 PPT（同事显卡，QLoRA）",
      "kind": "map",
      "recipe": "qa_train",
      "recipeFile": "../recipes/qa_train.py",
      "when": {
        "outputsOf": "ppt",
        "outputs": 40,
        "minHours": 6
      },
      "params": {
        "count": 1,
        "exam": "ppt",
        "name": "ppt-lora",
        "outputsOf": "ppt",
        "warmStart": "ppt-lora",
        "minExamples": 600,
        "maxExamples": 12000,
        "epochs": 2,
        "rank": 16,
        "lr": 0.0001,
        "maxLen": 4096,
        "evalN": 120,
        "oodN": 60,
        "mixOf": [
          {
            "tag": "qa-math",
            "max": 30
          },
          {
            "tag": "chat",
            "max": 10
          },
          {
            "tag": "ground",
            "max": 10
          }
        ],
        "mixShare": 0.2,
        "llm": {
          "lazy": true,
          "ctx": 16384,
          "slots": 2
        },
        "evalCtx": 16384,
        "modelsOf": [
          "base-stack"
        ],
        "examSlots": 2,
        "balance": {
          "by": "fam",
          "max": 0.15
        }
      },
      "req": {
        "vram": 7.5,
        "llm": true,
        "needFree": 6
      },
      "priority": 18
    }
  ],
  "publish": {
    "model": "ppt-lora",
    "from": "train",
    "files": [
      "lora",
      "peft"
    ],
    "metrics": [
      {
        "k": "acc",
        "better": "higher",
        "tol": 9,
        "min": "base_acc",
        "minTol": 0.05
      },
      {
        "k": "gain_lo",
        "better": "higher",
        "tol": 9,
        "min": -0.02
      },
      {
        "k": "cur_lo",
        "better": "higher",
        "tol": 9,
        "min": -0.02
      },
      {
        "k": "cur_gain",
        "better": "higher",
        "tol": 0,
        "vs": "zero"
      },
      {
        "k": "ood",
        "better": "higher",
        "tol": 9,
        "min": "base_ood",
        "minTol": 0.05
      }
    ]
  }
}