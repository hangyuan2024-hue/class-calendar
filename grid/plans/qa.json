          ],
          "mirrorModel": "gridTeacher"
        }
      },
      "req": {
        "vram": 7.5,
        "llm": true
      },
      "priority": 10
    },
    {
      "key": "math14",
      "name": "做数学题、写讲解（自动核对）（局域网大老师 14B：同一局域网的两台电脑合起来跑）",
      "kind": "map",
      "recipe": "qa_math",
      "recipeFile": "../recipes/qa_math.py",
      "standing": true,
      "keep": 10,
      "params": {
        "per": 12,
        "samples": 4,
        "parallel": 2,
        "sources": [
          "gsm8k",
          "topics"
        ],
        "tag": "qa-math",
        "llm": {
          "name": "Qwen3-14B-Q4_K_M.gguf",
          "ctx": 16384,
          "slots": 2,
          "urls": [
            "https://www.modelscope.cn/models/Qwen/Qwen3-14B-GGUF/resolve/master/Qwen3-14B-Q4_K_M.gguf",
            "https://hf-mirror.com/Qwen/Qwen3-14B-GGUF/resolve/main/Qwen3-14B-Q4_K_M.gguf",
            "https://huggingface.co/Qwen/Qwen3-14B-GGUF/resolve/main/Qwen3-14B-Q4_K_M.gguf"
          ]
        }
      },
      "req": {
        "vram": 7.5,
        "llm": true,
        "gang": {
          "size": 2,
          "minMbps": 10
        }
      },
      "priority": 11
    },
    {
      "key": "mathlite",
      "name": "做数学题（4～7G 的小显卡：小一号的模型，只做有标准答案的题）",
      "kind": "map",
      "recipe": "qa_math",
      "recipeFile": "../recipes/qa_math.py",
      "standing": true,
      "keep": 20,
      "params": {
        "per": 12,
        "samples": 4,
        "parallel": 1,
        "sources": [
          "gsm8k"
        ],
        "tag": "qa-math",
        "llm": {
          "name": "Qwen3-4B-Q4_K_M.gguf",
          "ctx": 8192,
          "slots": 1,
          "urls": [
            "https://www.modelscope.cn/models/Qwen/Qwen3-4B-GGUF/resolve/master/Qwen3-4B-Q4_K_M.gguf",
            "https://hf-mirror.com/Qwen/Qwen3-4B-GGUF/resolve/main/Qwen3-4B-Q4_K_M.gguf",
            "https://huggingface.co/Qwen/Qwen3-4B-GGUF/resolve/main/Qwen3-4B-Q4_K_M.gguf"
          ]
        }
      },
      "req": {
        "vram": 3.5,
        "maxVram": 7.4,
        "llm": true
      },
      "priority": 10
    },
    {
      "key": "train",
      "name": "训练答题大脑（同事显卡，QLoRA）",
      "kind": "map",
      "recipe": "qa_train",
      "recipeFile": "../recipes/qa_train.py",
      "when": {
        "outputsOf": "qa-math",
        "outputs": 100,
        "minHours": 6
      },
      "params": {
        "count": 1,
        "outputsOf": "qa-math",
        "warmStart": "qa-lora",
        "minExamples": 300,
        "maxExamples": 8000,
        "epochs": 2,
        "rank": 16,
        "lr": 0.0001,
        "maxLen": 1024,
        "evalN": 300,
        "llm": {
          "lazy": true,
          "ctx": 8192,
          "slots": 2
        },
        "modelsOf": [
          "base-stack"
        ]
      },
      "req": {
        "vram": 7.5,
        "llm": true,
        "needFree": 5.5
      },
      "priority": 20
    }
  ],
  "publish": {
    "model": "qa-lora",
    "from": "train",
    "files": [
      "lora",
      "peft"
    ],
    "metrics": [
      {
        "k": "acc",
        "better": "higher",
        "tol": 9,
        "min": "base_acc",
        "minTol": 0.05
      },
      {
        "k": "gain_lo",
        "better": "higher",
        "tol": 9,
        "min": -0.02
      },
      {
        "k": "cur_lo",
        "better": "higher",
        "tol": 9,
        "min": -0.02
      },
      {
        "k": "cur_gain",
        "better": "higher",
        "tol": 0,
        "vs": "zero"
      },
      {
        "k": "zh_rate",
        "better": "higher",
        "tol": 0.02
      },
      {
        "k": "frontier",
        "info": true
      }
    ]
  }
}