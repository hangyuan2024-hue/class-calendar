{
  "appId": "cn.laolaokechengbiao.xiaozhi",
  "productName": "捞小智",
  "copyright": "捞捞",
  "extraMetadata": {
    "name": "laolao-xiaozhi",
    "productName": "捞小智",
    "main": "xz/main.js",
    "description": "捞小智：捞捞的 AI 助教（体验版）"
  },
  "directories": {
    "output": "dist-xz",
    "buildResources": "build"
  },
  "files": [
    "package.json",
    "xz/**",
    "!xz/builder.json",
    "app/show.js",
    "app/llmw.js",
    "app/gsvw.js",
    "app/hear.js",
    "app/region.js",
    "app/kokoro.js",
    "app/localapi.js",
    "app/tts-worker.js",
    "app/realvoice.js",
    "app/avatar.js",
    "app/ai3d/**",
    "app/preload.js",
    "app/ppt/agent.js",
    "app/ppt/campus.js",
    "app/ppt/chat.js",
    "app/ppt/checkup.js",
    "app/ppt/deck.js",
    "app/ppt/dl.js",
    "app/ppt/gridmodels.js",
    "app/ppt/installer.js",
    "app/ppt/latex2omml.js",
    "app/ppt/media.js",
    "app/ppt/mirror.js",
    "app/ppt/pptedit.js",
    "app/ppt/pptview.js",
    "app/ppt/pptx.js",
    "app/ppt/systts.js",
    "app/ppt/voice.js",
    "app/ppt/xiaozhi.js",
    "app/ppt/websearch.js",
    "app/ppt/ground.js",
    "app/ppt/mindmap.js",
    "app/ppt/ai3d.js",
    "app/renderer/style.css",
    "app/renderer/show.js",
    "app/renderer/checkup.js",
    "app/renderer/zhi3d.js",
    "app/renderer/deckview.js",
    "app/renderer/avatar3d.js",
    "app/renderer/icon.png",
    "app/renderer/vendor/three/**",
    "py/asr_server.py",
    "!node_modules/@mediapipe/**",
    "!node_modules/three/**",
    "!node_modules/7zip-bin/linux/**",
    "!node_modules/7zip-bin/mac/**",
    "!node_modules/7zip-bin/win/ia32/**",
    "!node_modules/7zip-bin/win/arm64/**",
    "!node_modules/sherpa-onnx-win-ia32/**",
    "!node_modules/sherpa-onnx-win-arm64/**",
    "!node_modules/sherpa-onnx-linux-*/**",
    "!node_modules/sherpa-onnx-darwin-*/**",
    "!app/ai3d/**/__pycache__/**"
  ],
  "asarUnpack": [
    "py/**",
    "node_modules/7zip-bin/index.js",
    "node_modules/7zip-bin/package.json",
    "node_modules/7zip-bin/LICENSE.txt",
    "node_modules/7zip-bin/win/x64/**",
    "node_modules/sherpa-onnx-win-x64/**",
    "app/ai3d/**",
    "node_modules/sherpa-onnx-node/**",
    "app/tts-worker.js"
  ],
  "win": {
    "target": "nsis",
    "icon": "build/icon.ico",
    "artifactName": "LaolaoXiaozhi-Setup.exe"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "捞小智",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico"
  },
  "extraResources": [
    {
      "from": "llama",
      "to": "llama",
      "filter": [
        "llama-server.exe",
        "*.dll"
      ]
    }
  ]
}
