<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 准点提醒：上课、作业截止 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 「提醒与通知」里可以让用户把 App 设成不被省电模式拦住 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 5.9.4「游戏前先做 5 分钟」（默认关，用户自己打开并授权）：知道打开了哪个 App、在它上面弹一句、后台常驻 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <queries>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <intent><action android:name="android.intent.action.GET_CONTENT" /><data android:mimeType="image/*" /></intent>
        <intent><action android:name="android.intent.action.GET_CONTENT" /><data android:mimeType="*/*" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:mimeType="*/*" /></intent>
        <intent><action android:name="android.intent.action.INSERT" /><data android:mimeType="vnd.android.cursor.dir/event" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
        <!-- 5.9.4 选「打开哪些 App 时问一句」：列出桌面上能打开的 App -->
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.Main"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 别的 App 分享文字（备忘录、微信聊天）→ 拆成待办；分享图片 → 识别课表 -->
            <intent-filter android:label="记到捞捞课程表">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="识别成课程表">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- 一句话记事的小窗（小组件、快捷开关、长按图标） -->
        <activity
            android:name=".ui.QuickAdd"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="com.laolao.classcalendar.quick"
            android:theme="@style/AppTheme.Quick"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- 小组件里点一下：打勾 / 打开（看不见的中转页） -->
        <activity
            android:name=".widget.WidgetTap"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.laolao.classcalendar.tap"
            android:theme="@style/AppTheme.Invisible" />

        <!-- 桌面小组件 -->
        <receiver android:name=".widget.TodayWidget" android:exported="false" android:label="@string/w_today">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today" />
        </receiver>
        <receiver android:name=".widget.NextWidget" android:exported="false" android:label="@string/w_next">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_next" />
        </receiver>
        <receiver android:name=".widget.HomeworkWidget" android:exported="false" android:label="@string/w_hw">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_homework" />
        </receiver>
        <receiver android:name=".widget.QuickWidget" android:exported="false" android:label="@string/w_quick">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick" />
        </receiver>
        <service android:name=".widget.WidgetService" android:exported="false" android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- 提醒、后台同步 -->
        <receiver android:name=".work.ReminderReceiver" android:exported="false" />
        <receiver android:name=".work.DoneReceiver" android:exported="false" />
        <receiver android:name=".work.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
        <!-- 5.9.4 游戏前先做 5 分钟 -->
        <service android:name=".work.GuardService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="打开用户自己选的游戏时，提示先完成 5 分钟学习任务（用户主动开启）" />
        </service>
        <activity
            android:name=".work.GuardAsk"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.laolao.classcalendar.guard"
            android:theme="@style/AppTheme.Invisible" />
        <service android:name=".work.SyncJob" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 下拉通知栏的快捷开关 -->
        <service
            android:name=".ui.QuickTile"
            android:exported="true"
            android:icon="@drawable/ic_stat"
            android:label="@string/tile_add"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>

        <!-- 拍照：给相机 App 写照片的地方 -->
        <provider
            android:name=".ui.PhotoProvider"
            android:authorities="${applicationId}.photo"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 极光推送 -->
        <service
            android:name=".push.PushService"
            android:exported="false"
            android:process=":pushcore">
            <intent-filter><action android:name="cn.jiguang.user.service.action" /></intent-filter>
        </service>
        <receiver android:name=".push.PushReceiver" android:exported="false">
            <intent-filter>
                <action android:name="cn.jpush.android.intent.RECEIVER_MESSAGE" />
                <category android:name="${applicationId}" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
